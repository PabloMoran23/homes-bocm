{
  "ignoreCommand": "bash scripts/vercel-should-build.sh",
  "buildCommand": "npm run build:public",
  "installCommand": "npm install",
  "framework": "nextjs",
  "regions": ["fra1"],
  "crons": [
    { "path": "/api/analytics/retention", "schedule": "15 3 * * *" },
    { "path": "/api/cron/refresh-portal-snapshots", "schedule": "22 4 * * *" }
  ],
  "env": {
    "NEXT_PUBLIC_EDITION": "public",
    "NEXT_PUBLIC_MAP_SCOPE": "cm",
    "SKIP_BUILD_DATA": "1"
  },
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        { "key": "x-vercel-enable-rewrite-caching", "value": "1" },
        { "key": "CDN-Cache-Control", "value": "public, max-age=300, stale-while-revalidate=86400" },
        { "key": "Vercel-Cache-Tag", "value": "web-data" }
      ]
    }
  ]
}
